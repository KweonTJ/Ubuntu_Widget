+/// @widget xembed
+/// @desc Embed a GTK X11 plug, such as the optional official-web-app view.
+fn build_xembed(bargs: &mut BuilderArgs) -> Result<gtk::Socket> {
+    let gtk_widget = gtk::Socket::new();
+    let child: Rc<RefCell<Option<std::process::Child>>> = Rc::new(RefCell::new(None));
+    let stopped = child.clone();
+    gtk_widget.connect_destroy(move |_| {
+        if let Some(mut process) = stopped.borrow_mut().take() {
+            std::thread::spawn(move || { let _ = process.wait(); });
+        }
+    });
+    // Keep the host alive if a web process exits; the enclosing card stays usable.
+    gtk_widget.connect_plug_removed(|_| true);
+    def_widget!(bargs, _g, gtk_widget, {
+        // @prop command - command receiving its host XID in EWW_SOCKET_ID
+        prop(command: as_string) {
+            let running = child.clone();
+            connect_signal_handler!(gtk_widget, gtk_widget.connect_realize(move |socket| {
+                if running.borrow().is_some() { return; }
+                match std::process::Command::new("/bin/sh").args(["-c", &command])
+                    .env("EWW_SOCKET_ID", socket.id().to_string()).spawn() {
+                    Ok(process) => { *running.borrow_mut() = Some(process); }
+                    Err(error) => log::error!("Could not start embedded app: {}", error),
+                }
+            }));
+        }
+    });
+    Ok(gtk_widget)
