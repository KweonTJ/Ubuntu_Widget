+const SWIPE_BINDING: &str = "eww-native-stack-swipe";
+struct SwipeBinding {
+    enabled: bool,
+    action: Rc<dyn Fn(&str)>,
+}
+
+/// Shared across member windows: closing one card must not turn the remainder
+/// of a single touchpad stroke into a second switch in the newly mapped card.
+#[derive(Default)]
+struct SwipeMotion {
+    x: f64,
+    y: f64,
+    axis: u8,
+    fired: bool,
+    last_time: Option<u32>,
+    last_fire: Option<u32>,
+}
+impl SwipeMotion {
+    fn feed(&mut self, dx: f64, dy: f64, time: u32) -> (bool, Option<&'static str>) {
+        if !dx.is_finite() || !dy.is_finite() { return (false,None); }
+        if self.last_time.is_none_or(|last| time.wrapping_sub(last)>220) {
+            self.x=0.0; self.y=0.0; self.axis=0; self.fired=false;
+        }
+        self.last_time=Some(time); self.x+=dx; self.y+=dy;
+        if self.axis==0 && self.x.abs().max(self.y.abs())>=0.35 {
+            if self.x.abs()>self.y.abs()*1.6 { self.axis=1; }
+            else if self.y.abs()>self.x.abs()*1.6 { self.axis=2; }
+        }
+        let horizontal=self.axis==1;
+        if horizontal && !self.fired && self.x.abs()>=1.5
+            && self.last_fire.is_none_or(|last| time.wrapping_sub(last)>=420) {
+            self.fired=true; self.last_fire=Some(time);
+            return (true,Some(if self.x>0.0 { "next" } else { "prev" }));
+        }
+        (horizontal,None)
+    }
+}
+thread_local! {
+    static SWIPE_ROUTER: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    static SWIPE_MOTION: RefCell<SwipeMotion> = RefCell::new(SwipeMotion::default());
+}
+fn route_stack_scroll(event: &mut gdk::Event) -> bool {
+    let Some(scroll)=event.downcast_ref::<gdk::EventScroll>() else { return false };
+    if scroll.direction()!=gdk::ScrollDirection::Smooth { return false; }
+    let (dx,dy)=scroll.delta(); let time=scroll.time();
+    let Some(widget)=gtk::event_widget(event) else { return false };
+    let Some(window)=widget.toplevel().and_then(|w|w.downcast::<gtk::Window>().ok()) else { return false };
+    let binding=unsafe { window.data::<Rc<RefCell<SwipeBinding>>>(SWIPE_BINDING).map(|p|p.as_ref().clone()) };
+    let Some(binding)=binding else { return false };
+    let binding=binding.borrow();
+    if !binding.enabled { return false; }
+    let (handled,direction)=SWIPE_MOTION.with(|state|state.borrow_mut().feed(dx,dy,time));
+    if let Some(direction)=direction { (binding.action)(direction); }
+    handled
+}
+
+pub fn configure_swipe(handle: &gtk::EventBox, enabled: bool, action: impl Fn(&str)+'static) {
+    let existing=unsafe { handle.data::<Rc<RefCell<SwipeBinding>>>(SWIPE_BINDING).map(|p|p.as_ref().clone()) };
+    if let Some(existing)=existing {
+        *existing.borrow_mut()=SwipeBinding { enabled,action:Rc::new(action) }; return;
+    }
+    handle.add_events(gdk::EventMask::SCROLL_MASK | gdk::EventMask::SMOOTH_SCROLL_MASK);
+    let binding=Rc::new(RefCell::new(SwipeBinding { enabled,action:Rc::new(action) }));
+    unsafe { handle.set_data(SWIPE_BINDING,binding.clone()); }
+    let mapped=binding.clone();
+    handle.connect_map(move |handle| {
+        if let Some(window)=top(handle) {
+            window.add_events(gdk::EventMask::SCROLL_MASK | gdk::EventMask::SMOOTH_SCROLL_MASK);
+            unsafe { window.set_data(SWIPE_BINDING,mapped.clone()); }
+        }
+    });
+    if handle.is_mapped() {
+        if let Some(window)=top(handle) { unsafe { window.set_data(SWIPE_BINDING,binding); } }
+    }
+    SWIPE_ROUTER.with(|installed| {
+        if installed.replace(true) { return; }
+        // GTK's scroll controller consumes vertical events even with only its
+        // horizontal flag set. Filter just stack strokes before GTK dispatch;
+        // every unrelated/vertical event follows GTK's original normal path.
+        gdk::Event::set_handler(Some(|event: &mut gdk::Event| {
+            if !route_stack_scroll(event) { gtk::main_do_event(event); }
+        }));
+    });
+}
