+//! Native X11 desktop-widget movement and resizing in GDK logical coordinates.
+use gtk::{gdk, glib, prelude::*};
+use serde::{Deserialize, Serialize};
+use std::{cell::RefCell, collections::BTreeMap, rc::Rc, time::Duration};
+
+const MOVABLE: &str = "eww-native-draggable";
+const FILE: &str = "positions.json";
+
+#[derive(Clone, Copy, Serialize, Deserialize)]
+struct Position {
+    x: i32,
+    y: i32,
+}
+
+#[derive(Clone, Copy, Serialize, Deserialize)]
+struct Placement {
+    x: i32,
+    y: i32,
+    #[serde(default)]
+    width: Option<i32>,
+    #[serde(default)]
+    height: Option<i32>,
+}
+
+pub fn is_movable(window: &impl IsA<gtk::Window>) -> bool {
+    let window: &gtk::Window = window.as_ref();
+    unsafe { window.data::<bool>(MOVABLE).is_some() }
+}
+
+fn position(window: &gtk::Window) -> Position {
+    let (_, x, y) = window.window().unwrap().origin();
+    Position { x, y }
+}
+
+fn bounded(window: &gtk::Window, target: Position) -> Position {
+    let Some(display) = gdk::Display::default() else { return target };
+    let (width, height) = window.size();
+    let Some(monitor) =
+        display.monitor_at_point(target.x + width / 2, target.y + height / 2).or_else(|| display.primary_monitor())
+    else {
+        return target;
+    };
+    let area = monitor.workarea();
+    let left = area.x() + 8;
+    let top = area.y() + 8;
+    Position {
+        x: target.x.clamp(left, (area.x() + area.width() - width - 8).max(left)),
+        y: target.y.clamp(top, (area.y() + area.height() - height - 8).max(top)),
+    }
+}
+
+fn move_to(window: &gtk::Window, target: Position) {
+    let target = bounded(window, target);
+    let current = position(window);
+    if (current.x, current.y) != (target.x, target.y) {
+        if let Some(gdk_window) = window.window() {
+            gdk_window.move_(target.x, target.y);
+        }
+    }
+}
+
+fn snap(window: &gtk::Window, target: Position, grid: i32) -> Position {
+    let target = bounded(window, target);
+    if grid <= 1 {
+        return target;
+    }
+    let Some(display) = gdk::Display::default() else { return target };
+    let (width, height) = window.size();
+    let Some(monitor) = display.monitor_at_point(target.x + width / 2, target.y + height / 2) else { return target };
+    let area = monitor.workarea();
+    let axis = |value: i32, origin: i32, available: i32| {
+        let steps = ((value - origin) as f64 / grid as f64).round() as i32;
+        origin + steps.clamp(0, available.max(0) / grid) * grid
+    };
+    Position {
+        x: axis(target.x, area.x() + 8, area.width() - width - 16),
+        y: axis(target.y, area.y() + 8, area.height() - height - 16),
+    }
+}
+
+fn read_positions() -> BTreeMap<String, Placement> {
+    std::fs::read(FILE).ok().and_then(|bytes| serde_json::from_slice(&bytes).ok()).unwrap_or_default()
+}
+
+fn save(window: &gtk::Window) {
+    let mut positions = read_positions();
+    let key = window.title().unwrap_or_default().to_string();
+    let p = bounded(window, position(window));
+    let (width, height) = window.size();
+    positions.insert(key, Placement { x: p.x, y: p.y, width: Some(width), height: Some(height) });
+    let result = (|| -> anyhow::Result<()> {
+        std::fs::write("positions.json.tmp", serde_json::to_vec_pretty(&positions)?)?;
+        std::fs::rename("positions.json.tmp", FILE)?;
+        Ok(())
+    })();
+    if let Err(error) = result {
+        log::warn!("Could not save widget position: {error:#}");
+    }
+}
+
+fn top(widget: &gtk::EventBox) -> Option<gtk::Window> {
+    widget.toplevel()?.downcast::<gtk::Window>().ok()
+}
+
+fn initialize_handle(handle: &gtk::EventBox) {
+    let mut child: gtk::Widget = handle.clone().upcast();
+    while let Some(parent) = child.parent() {
+        if let Ok(overlay) = parent.clone().downcast::<gtk::Overlay>() {
+            if overlay.child().as_ref() != Some(&child) {
+                overlay.set_overlay_pass_through(&child, false);
+            }
+            break;
+        }
+        child = parent;
+    }
+    let Some(window) = top(handle) else { return };
+    initialize_window_controls(&window);
+}
+
+fn initialize_window_controls(window: &gtk::Window) {
+    if is_movable(window) { return; }
+    unsafe { window.set_data(MOVABLE, true); }
+    window.set_gravity(gdk::Gravity::NorthWest);
+    // Correct placement when a monitor is disconnected or scaling changes.
+    if let Some(screen) = gtk::prelude::GtkWindowExt::screen(window) {
+        let weak = window.downgrade();
+        let signal = screen.connect_monitors_changed(move |_| {
+            let weak = weak.clone();
+            glib::timeout_add_local_once(Duration::from_millis(300), move || {
+                if let Some(window) = weak.upgrade() {
+                    move_to(&window, position(&window));
+                    save(&window);
+                }
+            });
+        });
+        let signal = RefCell::new(Some(signal));
+        window.connect_destroy(move |_| {
+            if let Some(signal) = signal.borrow_mut().take() {
+                screen.disconnect(signal);
+            }
+        });
+    }
+    // Content can grow after a font/theme change; keep the whole card visible.
+    window.connect_size_allocate(|window, _| {
+        let weak = window.downgrade();
+        glib::idle_add_local_once(move || {
+            if let Some(window) = weak.upgrade() {
+                if window.is_mapped() {
+                    move_to(&window, position(&window));
+                }
+            }
+        });
+    });
+}
+
+fn contains_controls(widget: &gtk::Widget) -> bool {
+    if unsafe { widget.data::<bool>("eww-native-handle").is_some() } { return true; }
+    widget.clone().downcast::<gtk::Container>().ok()
+        .is_some_and(|container| container.children().iter().any(contains_controls))
+}
+
+/// Apply saved geometry before the window is first mapped. Never expose the
+/// definition's default rectangle and then correct it with delayed timers.
+pub fn restore_before_map(window: &impl IsA<gtk::Window>, root: &gtk::Widget) {
+    if !contains_controls(root) { return; }
+    let window=window.as_ref();
+    initialize_window_controls(window);
+    let Some(saved)=read_positions().get(window.title().unwrap_or_default().as_str()).copied() else { return };
+    let Some(monitor)=gdk::Display::default().and_then(|d|d.monitor_at_point(saved.x,saved.y).or_else(||d.primary_monitor())) else { return };
+    let area=monitor.workarea();
+    let width=saved.width.unwrap_or(window.size().0).clamp(1,(area.width()-16).max(1));
+    let height=saved.height.unwrap_or(window.size().1).clamp(1,(area.height()-16).max(1));
+    let x=saved.x.clamp(area.x()+8,(area.x()+area.width()-width-8).max(area.x()+8));
+    let y=saved.y.clamp(area.y()+8,(area.y()+area.height()-height-8).max(area.y()+8));
+    window.set_size_request(1,1);
+    window.set_default_size(width,height);
+    window.resize(width,height);
+    window.move_(x,y);
+}
+
+const STACK_HOST: &str="eww-native-stack-host";
+
+/// Keep one mapped X11 window, clip natural content sizes, and animate only
+/// its pages. The outgoing page lives until GTK has completed the transition.
+pub fn switch_content(window: &impl IsA<gtk::Window>, root: &gtk::Widget, direction: &str) -> anyhow::Result<()> {
+    let window=window.as_ref();
+    let existing=unsafe { window.data::<gtk::Stack>(STACK_HOST).map(|p|p.as_ref().clone()) };
+    let stack=if let Some(stack)=existing { stack } else {
+        let previous=window.child().ok_or_else(||anyhow::anyhow!("Stack host has no content"))?;
+        let stack=gtk::Stack::new();
+        stack.set_homogeneous(false);stack.set_interpolate_size(false);
+        stack.set_transition_duration(200);
+        let clip=gtk::ScrolledWindow::new(None::<&gtk::Adjustment>,None::<&gtk::Adjustment>);
+        clip.set_policy(gtk::PolicyType::External,gtk::PolicyType::External);
+        clip.set_propagate_natural_width(false);clip.set_propagate_natural_height(false);
+        // This viewport only clips layout requests. Scroll the card's own
+        // content, never shift the entire card frame inside the host.
+        clip.connect_scroll_event(|_,_|glib::Propagation::Stop);
+        window.remove(&previous);stack.add_named(&previous,"previous");
+        clip.add(&stack);window.add(&clip);clip.show_all();
+        unsafe { window.set_data(STACK_HOST,stack.clone()); }
+        stack
+    };
+    // A new stroke can interrupt a transition; GTK snapshots the current page.
+    // Keep unique child names, including a rapid return to the previous kind.
+    let name=format!("page-{}",glib::monotonic_time());
+    stack.add_named(root,&name);root.show_all();
+    stack.set_visible_child_full(&name,if direction=="prev" {gtk::StackTransitionType::SlideRight} else {gtk::StackTransitionType::SlideLeft});
+    let weak=stack.downgrade();
+    glib::timeout_add_local_once(Duration::from_millis(240),move || {
+        let Some(stack)=weak.upgrade() else { return };
+        if !stack.is_transition_running() {
+            for child in stack.children() {
+                if Some(&child)!=stack.visible_child().as_ref() { stack.remove(&child); }
+            }
+        }
+    });
+    Ok(())
+}
+
+pub fn geometry_json(window: &impl IsA<gtk::Window>) -> String {
+    let window=window.as_ref();let p=position(window);let (width,height)=window.size();
+    serde_json::json!({"x":p.x,"y":p.y,"width":width,"height":height}).to_string()
+}
+
+#[derive(Clone, Copy)]
+struct Drag {
+    pointer: (f64, f64),
+    origin: Position,
+    active: bool,
+}
+
+fn gesture_pointer(gesture: &gtk::GestureDrag) -> Option<(f64, f64)> {
+    gesture.last_event(gesture.current_sequence().as_ref())?.root_coords()
+}
+
+fn drop_outline(source: Option<&gtk::Window>) {
+    for widget in gtk::Window::list_toplevels() {
+        let Ok(target) = widget.downcast::<gtk::Window>() else { continue };
+        let matches = source.is_some_and(|source| {
+            if source == &target || !target.is_mapped() || !is_movable(&target) || source.size() != target.size() { return false; }
+            let a = position(source); let b = position(&target); let (w,h) = source.size();
+            let area = (a.x+w).min(b.x+w).saturating_sub(a.x.max(b.x)).max(0) as f64
+                     * (a.y+h).min(b.y+h).saturating_sub(a.y.max(b.y)).max(0) as f64;
+            area / (w.max(1) as f64 * h.max(1) as f64) >= 0.65
+        });
+        let context = target.style_context();
+        if matches { context.add_class("stack-drop-target"); } else { context.remove_class("stack-drop-target"); }
+    }
+}
+
+pub fn install(handle: &gtk::EventBox, grid: i32, on_drop: impl Fn([i32; 6]) + 'static) {
+    unsafe { handle.set_data("eww-native-handle",true); }
+    let drag: Rc<RefCell<Option<Drag>>> = Rc::new(RefCell::new(None));
+    handle.add_events(
+        gdk::EventMask::BUTTON_PRESS_MASK | gdk::EventMask::BUTTON_RELEASE_MASK | gdk::EventMask::POINTER_MOTION_MASK,
+    );
+    handle.connect_map(initialize_handle);
+    // Capture descendant labels and scroll viewports as well as blank space.
+    // Do not claim clicks, scrollbars or interactive controls for movement.
+    let gesture = gtk::GestureDrag::new(handle);
+    gesture.set_button(1);
+    gesture.set_propagation_phase(gtk::PropagationPhase::Capture);
+    gesture.connect_drag_begin(glib::clone!(@weak handle, @strong drag => move |gesture, _, _| {
+        *drag.borrow_mut() = None;
+        let Some(mut event) = gesture.last_event(gesture.current_sequence().as_ref()) else { return };
+        let mut target = gtk::event_widget(&mut event);
+        while let Some(widget) = target {
+            if widget == handle.clone().upcast::<gtk::Widget>() { break; }
+            if widget.is::<gtk::Button>() || widget.is::<gtk::Range>() || widget.is::<gtk::Entry>()
+                || widget.is::<gtk::TextView>() || widget.is::<gtk::ComboBox>() {
+                gesture.set_state(gtk::EventSequenceState::Denied);
+                return;
+            }
+            target = widget.parent();
+        }
+        if let (Some(window), Some(pointer)) = (top(&handle), event.root_coords()) {
+            *drag.borrow_mut() = Some(Drag { pointer, origin: position(&window), active: false });
+        }
+    }));
+    gesture.connect_drag_update(glib::clone!(@weak handle, @strong drag => move |gesture, _, _| {
+        let Some(mut state) = *drag.borrow() else { return };
+        let Some((x, y)) = gesture_pointer(gesture) else { return };
+        if !state.active {
+            if !handle.drag_check_threshold(state.pointer.0.round() as i32, state.pointer.1.round() as i32,
+                                             x.round() as i32, y.round() as i32) { return; }
+            if !gesture.set_state(gtk::EventSequenceState::Claimed) { return; }
+            state.active = true;
+            *drag.borrow_mut() = Some(state);
+        }
+        if let Some(window) = top(&handle) {
+            move_to(&window, snap(&window, Position {
+                x: state.origin.x + (x - state.pointer.0).round() as i32,
+                y: state.origin.y + (y - state.pointer.1).round() as i32,
+            }, grid));
+            drop_outline(Some(&window));
+        }
+    }));
+    gesture.connect_drag_end(glib::clone!(@weak handle, @strong drag => move |_, _, _| {
+        let state = drag.borrow_mut().take();
+        drop_outline(None);
+        if let Some(state) = state.filter(|s| s.active) {
+            if let Some(window) = top(&handle) {
+                move_to(&window, snap(&window, position(&window), grid));
+                save(&window);
+                let p = position(&window); let (width,height) = window.size();
+                on_drop([state.origin.x,state.origin.y,p.x,p.y,width,height]);
+            }
+        }
+    }));
+    gesture.connect_cancel(move |_, _| { *drag.borrow_mut() = None; drop_outline(None); });
+    // Event controllers must live for as long as their widget, without a
+    // strong reference back to the widget in any of the signal closures.
+    unsafe { handle.set_data("eww-window-drag-gesture", gesture); }
+}
+
+fn dimension(value: i32, minimum: i32, maximum: i32, grid: i32) -> i32 {
+    let grid = grid.max(1);
+    let min_steps = (minimum + grid - 1) / grid;
+    let max_steps = (maximum / grid).max(min_steps);
+    (((value as f64 / grid as f64).round() as i32).clamp(min_steps, max_steps)) * grid
+}
+
+fn resize_to(window: &gtk::Window, width: i32, height: i32, grid: i32, min_width: i32, min_height: i32) {
+    let p = position(window);
+    let Some(display) = gdk::Display::default() else { return };
+    let Some(monitor) = display.monitor_at_point(p.x, p.y) else { return };
+    let area = monitor.workarea();
+    let width = dimension(width, min_width, area.x() + area.width() - p.x - 8, grid);
+    let height = dimension(height, min_height, area.y() + area.height() - p.y - 8, grid);
+    window.resize(width, height);
+}
+
+pub fn install_resize(handle: &gtk::EventBox, grid: i32, min_width: i32, min_height: i32, axis: &str, edge: &str) {
+    unsafe { handle.set_data("eww-native-handle",true); }
+    let from_left = edge == "left";
+    let horizontal_only = axis == "horizontal";
+    let vertical_only = axis == "vertical";
+    let resizing: Rc<RefCell<Option<(f64, f64, i32, i32, Position)>>> = Rc::new(RefCell::new(None));
+    handle.add_events(
+        gdk::EventMask::BUTTON_PRESS_MASK | gdk::EventMask::BUTTON_RELEASE_MASK | gdk::EventMask::POINTER_MOTION_MASK,
+    );
+    handle.connect_map(move |handle| {
+        initialize_handle(handle);
+        if let Some(window) = top(handle) {
+            window.set_resizable(true);
+            window.set_size_request(min_width.max(1), min_height.max(1));
+        }
+    });
+    handle.connect_button_press_event(glib::clone!(@strong resizing => move |handle, event| {
+        if event.button() != 1 { return glib::Propagation::Proceed }
+        if let Some(window) = top(handle) {
+            let (x, y) = event.root();
+            let (width, height) = window.size();
+            *resizing.borrow_mut() = Some((x, y, width, height, position(&window)));
+            handle.grab_add();
+            return glib::Propagation::Stop;
+        }
+        glib::Propagation::Proceed
+    }));
+    handle.connect_motion_notify_event(glib::clone!(@strong resizing => move |handle, event| {
+        if let Some((start_x, start_y, width, height, origin)) = *resizing.borrow() {
+            if let Some(window) = top(handle) {
+                let (x, y) = event.root();
+                if from_left && !vertical_only {
+                    let right = origin.x + width;
+                    if let Some(monitor) = gdk::Display::default().and_then(|d| d.monitor_at_point(origin.x, origin.y)) {
+                        let requested = width - (x - start_x).round() as i32;
+                        let new_width = dimension(requested, min_width, right - monitor.workarea().x() - 8, grid);
+                        window.resize(new_width, height);
+                        if let Some(gdk_window) = window.window() {
+                            gdk_window.move_resize(right - new_width, origin.y, new_width, height);
+                        }
+                    }
+                } else {
+                    resize_to(&window, if vertical_only { window.size().0 } else { width + (x - start_x).round() as i32 },
+                        if horizontal_only { window.size().1 } else { height + (y - start_y).round() as i32 }, grid, min_width, min_height);
+                }
+            }
+            return glib::Propagation::Stop;
+        }
+        glib::Propagation::Proceed
+    }));
+    handle.connect_button_release_event(glib::clone!(@strong resizing => move |handle, event| {
+        if event.button() != 1 { return glib::Propagation::Proceed; }
+        let state = resizing.borrow_mut().take();
+        if let Some((_, _, width, _, origin)) = state {
+            handle.grab_remove();
+            if let Some(window) = top(handle) {
+                let weak = window.downgrade();
+                glib::timeout_add_local_once(Duration::from_millis(120), move || {
+                    if let Some(window) = weak.upgrade() {
+                        if from_left {
+                            move_to(&window, Position { x: origin.x + width - window.size().0, y: origin.y });
+                        } else {
+                            move_to(&window, position(&window));
+                        }
+                        save(&window);
+                    }
+                });
+            }
+            return glib::Propagation::Stop;
+        }
+        glib::Propagation::Proceed
+    }));
+    handle.connect_grab_broken_event(move |handle, _| {
+        *resizing.borrow_mut() = None;
+        handle.grab_remove();
+        glib::Propagation::Proceed
+    });
