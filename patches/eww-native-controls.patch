+/// @widget xembed
+/// @desc Embed a GTK X11 plug, such as the optional official-web-app view.
+fn build_xembed(bargs: &mut BuilderArgs) -> Result<gtk::Socket> {
+    let gtk_widget = gtk::Socket::new();
+    let child: Rc<RefCell<Option<std::process::Child>>> = Rc::new(RefCell::new(None));
+    let stopped = child.clone();
+    gtk_widget.connect_destroy(move |_| {
+        if let Some(mut process) = stopped.borrow_mut().take() {
+            std::thread::spawn(move || { let _ = process.wait(); });
+        }
