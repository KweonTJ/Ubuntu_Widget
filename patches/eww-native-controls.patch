+#[cfg(test)]
+mod stack_motion_tests {
+    use super::*;
+    #[test]
+    fn one_horizontal_switch_per_continuous_stroke_and_inertia() {
+        let mut motion=SwipeMotion::default(); let mut actions=Vec::new();
+        for t in (1000..2000).step_by(20) { if let Some(d)=motion.feed(0.4,0.03,t).1 { actions.push(d); } }
+        assert_eq!(actions,vec!["next"]);
+        assert_eq!(motion.feed(0.0,0.0,2000).1,None);
+        assert_eq!(motion.feed(-2.0,0.0,2500).1,Some("prev"));
+    }
+    #[test]
+    fn vertical_scroll_and_small_or_diagonal_noise_never_switch() {
+        let mut motion=SwipeMotion::default();
+        for t in (1000..2000).step_by(20) { assert_eq!(motion.feed(0.02,0.4,t),(false,None)); }
+        assert_eq!(motion.feed(0.1,0.0,2500).1,None);
+        let mut diagonal=SwipeMotion::default();
+        for t in (1000..2000).step_by(20) { assert_eq!(diagonal.feed(0.3,0.3,t),(false,None)); }
+    }
+    #[test]
+    fn gtk_dispatch_preserves_vertical_scrolling_and_latches_across_windows() {
+        use glib::translate::*;
+        gtk::init().expect("Run this test on Xvfb");
+        gtk::Settings::default().unwrap().set_property("gtk-enable-animations",true);
+        let actions=Rc::new(RefCell::new(Vec::<String>::new()));
+        fn drain() { for _ in 0..8 { while gtk::events_pending() { gtk::main_iteration_do(false); } std::thread::sleep(Duration::from_millis(10)); } }
+        fn card(actions: Rc<RefCell<Vec<String>>>) -> (gtk::Window,gtk::ScrolledWindow) {
+            let window=gtk::Window::new(gtk::WindowType::Toplevel);window.set_default_size(320,224);
+            let handle=gtk::EventBox::new();
+            let scroll=gtk::ScrolledWindow::new(None::<&gtk::Adjustment>,None::<&gtk::Adjustment>);
+            let label=gtk::Label::new(Some("Scrollable task content"));label.set_size_request(250,1200);
+            scroll.add(&label);handle.add(&scroll);window.add(&handle);
+            configure_swipe(&handle,true,move |direction|actions.borrow_mut().push(direction.into()));
+            window.show_all();drain();(window,scroll)
+        }
+        fn send(window: &gtk::Window,dx: f64,dy: f64,time: u32) {
+            let mut event=gdk::Event::new(gdk::EventType::Scroll);
+            let display=gdk::Display::default().unwrap();
+            event.set_device(display.default_seat().and_then(|s|s.pointer()).as_ref());
+            unsafe {
+                let ptr: *mut gdk::ffi::GdkEvent=event.to_glib_none_mut().0;
+                (*ptr).scroll.window=window.window().unwrap().to_glib_full();
+                (*ptr).scroll.direction=gdk::ffi::GDK_SCROLL_SMOOTH;
+                (*ptr).scroll.time=time;(*ptr).scroll.x=40.0;(*ptr).scroll.y=40.0;
+                (*ptr).scroll.delta_x=dx;(*ptr).scroll.delta_y=dy;
+            }
+            event.put();drain();
+        }
+        let (first,_)=card(actions.clone());
+        for i in 0..5 { send(&first,0.4,0.01,1000+i*20); }
+        assert_eq!(*actions.borrow(),vec!["next"]);
+        unsafe { first.destroy(); }
+        let (second,scroll)=card(actions.clone());
+        for i in 0..8 { send(&second,0.4,0.01,1100+i*20); }
+        assert_eq!(*actions.borrow(),vec!["next"],"The rest of one stroke must not flip the new member");
+        send(&second,-2.0,0.0,1900);
+        assert_eq!(*actions.borrow(),vec!["next","prev"]);
+        // Target a descendant's native GDK window so GTK handles its viewport.
+        let before=scroll.vadjustment().value();
+        let mut event=gdk::Event::new(gdk::EventType::Scroll);
+        event.set_device(gdk::Display::default().unwrap().default_seat().and_then(|s|s.pointer()).as_ref());
+        unsafe { let p: *mut gdk::ffi::GdkEvent=event.to_glib_none_mut().0;(*p).scroll.window=scroll.window().unwrap().to_glib_full();
+            (*p).scroll.direction=gdk::ffi::GDK_SCROLL_SMOOTH;(*p).scroll.time=2500;
+            (*p).scroll.x=40.0;(*p).scroll.y=40.0;(*p).scroll.delta_y=4.0; }
+        event.put();drain();
+        assert!(scroll.vadjustment().value()>before,"Vertical content scrolling must keep working");
+        assert_eq!(actions.borrow().len(),2);
+        let handle=second.child().unwrap().downcast::<gtk::EventBox>().unwrap();
+        configure_swipe(&handle,false,|_|panic!("A non-stack must not switch"));
+        send(&second,2.0,0.0,3100);
+        assert_eq!(actions.borrow().len(),2);
+        let again=actions.clone();
+        configure_swipe(&handle,true,move |direction|again.borrow_mut().push(direction.into()));
+        send(&second,-2.0,0.0,3800);
+        assert_eq!(*actions.borrow(),vec!["next","prev","prev"]);
+        unsafe { second.destroy(); } drain();
+        // A large incoming page must never resize/reposition the native host.
+        let fixed=gtk::Window::new(gtk::WindowType::Toplevel);
+        fixed.set_default_size(192,96);fixed.move_(120,100);
+        let original=gtk::Label::new(Some("First card"));fixed.add(&original);fixed.show_all();drain();
+        let rect=geometry_json(&fixed);
+        let large=gtk::Label::new(Some("A page with a much larger natural size"));large.set_size_request(1200,900);
+        let incoming:gtk::Widget=large.upcast();
+        switch_content(&fixed,&incoming,"next").unwrap();
+        let mut running=false;
+        for _ in 0..35 {
+            while gtk::events_pending() { gtk::main_iteration_do(false); }
+            assert_eq!(geometry_json(&fixed),rect,"An animation frame changed host geometry");
+            let stack=unsafe {fixed.data::<gtk::Stack>(STACK_HOST).unwrap().as_ref().clone()};
+            running|=stack.is_transition_running();
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        assert!(running,"GTK must animate the page rather than remap the window");
+        let stack=unsafe {fixed.data::<gtk::Stack>(STACK_HOST).unwrap().as_ref().clone()};
+        assert_eq!(stack.children().len(),1,"Outgoing pages must be released after animation");
+        let inner=gtk::ScrolledWindow::new(None::<&gtk::Adjustment>,None::<&gtk::Adjustment>);
+        let content=gtk::Label::new(Some("Scroll inside the new card"));content.set_size_request(100,1000);inner.add(&content);
+        let small:gtk::Widget=inner.clone().upcast();
+        switch_content(&fixed,&small,"prev").unwrap();drain();
+        assert_eq!(geometry_json(&fixed),rect);
+        let offset=inner.vadjustment().value();
+        let mut vertical=gdk::Event::new(gdk::EventType::Scroll);
+        vertical.set_device(gdk::Display::default().unwrap().default_seat().and_then(|s|s.pointer()).as_ref());
+        unsafe {let p:*mut gdk::ffi::GdkEvent=vertical.to_glib_none_mut().0;
+            (*p).scroll.window=inner.window().unwrap().to_glib_full();(*p).scroll.direction=gdk::ffi::GDK_SCROLL_SMOOTH;
+            (*p).scroll.time=5000;(*p).scroll.x=40.0;(*p).scroll.y=40.0;(*p).scroll.delta_y=4.0;}
+        vertical.put();drain();
+        assert!(inner.vadjustment().value()>offset,"The persistent host must preserve inner vertical scrolling");
+        assert_eq!(geometry_json(&fixed),rect);
+        unsafe {fixed.destroy();}drain();
+
+    }
+
