(defwidget note-card []
 (extra-card :kind "note" :title "메모" :tone "yellow"
  (label :class "extra-note-title" :text {extra.note_title ?: "메모"} :xalign 0 :wrap true :wrap-mode "wordchar")
 (label :class "extra-note" :text {extra.note_text ?: ""} :xalign 0 :yalign 0 :wrap true :wrap-mode "wordchar" :vexpand true)(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-note" (label :text "편집"))))
(defwindow uw-note
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-note" (note-card)))
(defwidget todo-card []
 (extra-card :kind "todo" :title "할 일" :tone "yellow"
  (label :class "extra-detail" :text {extra.tasks_count ?: "0 / 0 완료"} :xalign 0)
 (label :class "extra-detail" :visible {extra.tasks_empty ?: false} :text "할 일을 추가해 보세요." :xalign 0 :wrap true :wrap-mode "wordchar")
 (box :orientation "v" :space-evenly false :spacing 7 :vexpand true
   (for task in {extra.tasks ?: "[]"}
     (button :class {"extra-task " + (task.done ? "done" : "")}
       :onclick {"./scripts/library_data.py action toggle-task " + task.id}
       (box :space-evenly false :spacing 8
         (label :text {task.done ? "☑" : "☐"})
         (label :text {task.text} :xalign 0 :wrap true :wrap-mode "wordchar" :hexpand true)))))(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-todo" (label :text "목록 편집"))))
(defwindow uw-todo
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-todo" (todo-card)))
(defwidget focus-card []
 (extra-card :kind "focus" :title "집중 타이머" :tone "yellow"
  (label :class "extra-value" :truncate true :style {sizes["focus"].height < 160 || sizes["focus"].width < 264 ? "font-size: 26px;" : "font-size: 40px;"} :text {extra.focus_time ?: "25:00"} :xalign 0 :vexpand true)(label :class "extra-detail" :text {extra.focus_detail ?: "집중"} :xalign 0 :wrap true :wrap-mode "wordchar")(progress :value {extra.focus_percent ?: 0})
 (box :space-evenly true :spacing 8 :orientation {sizes.focus.width < 240 ? "v" : "h"}
   (button :class "extra-button" :onclick "./scripts/library_data.py action focus-toggle" (label :text {extra.focus_button ?: "시작"}))
   (button :class "extra-button" :onclick "./scripts/library_data.py action focus-reset" (label :text "초기화")))))
(defwindow uw-focus
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
