; Built-in catalogue widgets. Shared sizing, themes and native controls.
(defwidget extra-card [kind title tone]
 (box :class {"card extra-card glass-uw-" + kind + " extra-" + tone + (" size-" + sizes[kind].mode)}
   :style {"padding: " + sizes[kind].padding + "px;"} :orientation "v" :space-evenly false :vexpand true
   (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
     (box :orientation "v" :space-evenly false :spacing {sizes[kind].gap} :hexpand true :vexpand true
       (label :visible {sizes[kind].height >= 128} :class "extra-heading" :style {"font-size: " + sizes[kind].detail + "px;"} :text title :xalign 0)
       (children)))))
(defwidget worldclock-card []
 (extra-card :kind "worldclock" :title "세계 시계" :tone "blue"
  (box :orientation "v" :spacing 10 :space-evenly false :vexpand true
   (for city in {extra.world ?: "[]"}
     (box :space-evenly false :spacing 8
       (label :class "extra-city" :text {city.city} :xalign 0 :hexpand true)
       (label :class "extra-detail" :text {city.date})
       (label :class "extra-world-time" :style {"font-size: " + sizes.worldclock.title * 1.4 + "px;"} :text {city.time}))))))
(defwindow uw-worldclock
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-worldclock" (worldclock-card)))
(defwidget today-card []
 (extra-card :kind "today" :title "오늘 날짜" :tone "blue"
  (label :class "extra-value" :truncate true :style {"font-size: " + sizes["today"].hero + "px;"} :text {extra.today ?: "—"} :xalign 0 :vexpand true)(label :class "extra-detail" :text {extra.month + " · " + extra.weekday} :xalign 0 :wrap true :wrap-mode "wordchar")(label :class "extra-detail" :text {extra.week} :xalign 0 :wrap true :wrap-mode "wordchar")))
(defwindow uw-today
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-today" (today-card)))
(defwidget dayprogress-card []
 (extra-card :kind "dayprogress" :title "하루 진행률" :tone "blue"
  (label :class "extra-value" :truncate true :style {"font-size: " + sizes["dayprogress"].hero + "px;"} :text {(extra.day_percent ?: 0) + "%"} :xalign 0 :vexpand true)(progress :value {extra.day_percent ?: 0})(label :class "extra-detail" :text {extra.day_left ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")))
(defwindow uw-dayprogress
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-dayprogress" (dayprogress-card)))
