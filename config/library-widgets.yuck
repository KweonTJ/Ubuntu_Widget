(defwidget countdown-card []
 (extra-card :kind "countdown" :title "디데이" :tone "blue"
  (label :class "extra-value" :truncate true :style {"font-size: " + sizes["countdown"].hero + "px;"} :text {extra.countdown_value ?: "D-DAY"} :xalign 0 :vexpand true)(label :class "extra-detail" :text {extra.countdown_title ?: "디데이"} :xalign 0 :wrap true :wrap-mode "wordchar")(label :class "extra-detail" :text {extra.countdown_date ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-countdown" (label :text "날짜 설정"))))
(defwindow uw-countdown
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-countdown" (countdown-card)))
(defwidget note-card []
 (extra-card :kind "note" :title "OBSIDIAN" :tone "purple"
  (label :class "extra-note-title" :style {"font-size: " + sizes.note.title + "px;"} :text {extra.obsidian_title ?: "Obsidian"} :xalign 0 :wrap true :wrap-mode "wordchar")
  (label :class "extra-note" :text {extra.obsidian_text ?: "표시할 노트를 선택하세요."} :xalign 0 :yalign 0 :wrap true :wrap-mode "wordchar" :vexpand true)
  (box :space-evenly true :spacing 8 :orientation {sizes.note.width < 264 ? "v" : "h"}
   (button :class "extra-button" :onclick "./scripts/app_links.py open obsidian" (label :text "Obsidian에서 열기"))
   (button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-note" (label :text "노트 선택")))))
(defwindow uw-note
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-note" (note-card)))
(defwidget todo-task [task]
 (button :class {"extra-task " + (task.done ? "done" : "")} :active {!task.pending && extra.todomate_status == "ready"}
  :onclick {"./scripts/todomate.py toggle " + task.id + " " + (task.done ? "true" : "false") + " " + extra.todomate_date}
  (box :space-evenly false :spacing 9
   (label :class "task-check" :text {task.pending ? "◌" : task.done ? "●" : "○"} :valign "start")
   (label :text {task.text} :style {"font-size: " + sizes.todo.body + "px;"} :xalign 0 :wrap true :wrap-mode "wordchar" :limit-width 1 :hexpand true))))
(defwidget todo-card []
 (box :class {"card extra-neutral glass-uw-todo size-" + sizes.todo.mode} :style {"padding: " + sizes.todo.padding + "px;"} :orientation "v" :space-evenly false :vexpand true :spacing {sizes.todo.gap}
  (box :space-evenly false
   (label :class "extra-heading" :text "todomate" :xalign 0 :hexpand true)
   (button :class "subtle-action" :onclick "./scripts/manager-launch.py app todomate" :tooltip "todomate 연결 화면" (label :text "열기 ↗")))
  (label :visible {sizes.todo.height >= 280} :class "extra-note-title" :style {"font-size: " + sizes.todo.title + "px;"} :text "오늘의 할 일" :xalign 0)
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :spacing 2
    (label :visible {!(extra.todomate_ready ?: false) || (extra.todomate_open_tasks ?: "[]") == "[]"} :class "extra-detail" :text {extra.todomate_message ?: "todomate를 연결하세요."} :xalign 0 :yalign 0 :wrap true :wrap-mode "wordchar" :limit-width 1 :hexpand true)
    (for task in {extra.todomate_open_tasks ?: "[]"}
     (todo-task :task {task}))
    (expander :class "todo-completed" :visible {(extra.todomate_completed_count ?: 0) > 0} :expanded false
     :name {"완료 " + (extra.todomate_completed_count ?: 0) + "개"}
     (box :class "todo-completed-list" :orientation "v" :space-evenly false :spacing 2
      (for task in {extra.todomate_completed_tasks ?: "[]"}
       (todo-task :task {task}))))))
  (label :visible {(extra.todomate_ready ?: false) && sizes.todo.height >= 160} :class "extra-detail" :text {extra.todomate_count ?: ""} :xalign 0)))
(defwindow uw-todo
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-todo" (todo-card)))
(defwidget focus-card []
 (extra-card :kind "focus" :title "집중 타이머" :tone "yellow"
  (label :class "extra-value" :truncate true :style {"font-size: " + sizes["focus"].hero + "px;"} :text {extra.focus_time ?: "25:00"} :xalign 0 :vexpand true)(label :class "extra-detail" :text {extra.focus_detail ?: "집중"} :xalign 0 :wrap true :wrap-mode "wordchar")(progress :value {extra.focus_percent ?: 0})
 (box :space-evenly true :spacing 8 :orientation {sizes.focus.width < 240 ? "v" : "h"}
   (button :class "extra-button" :onclick "./scripts/library_data.py action focus-toggle" (label :text {extra.focus_button ?: "시작"}))
   (button :class "extra-button" :onclick "./scripts/library_data.py action focus-reset" (label :text "초기화")))))
