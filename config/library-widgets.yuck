 (extra-card :kind "yearprogress" :title "올해 진행률" :tone "blue"
  (label :class "extra-value" :truncate true :style {"font-size: " + sizes["yearprogress"].hero + "px;"} :text {(extra.year_percent ?: 0) + "%"} :xalign 0 :vexpand true)(progress :value {extra.year_percent ?: 0})(label :class "extra-detail" :text {extra.year_left ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")))
(defwindow uw-yearprogress
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
