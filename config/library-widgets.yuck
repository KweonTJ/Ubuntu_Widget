(defwidget countdown-card []
 (extra-card :kind "countdown" :title "디데이" :tone "blue"
  (label :class "extra-value" :truncate true :style {sizes["countdown"].height < 160 || sizes["countdown"].width < 264 ? "font-size: 26px;" : "font-size: 40px;"} :text {extra.countdown_value ?: "D-DAY"} :xalign 0 :vexpand true)(label :class "extra-detail" :text {extra.countdown_title ?: "디데이"} :xalign 0 :wrap true :wrap-mode "wordchar")(label :class "extra-detail" :text {extra.countdown_date ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-countdown" (label :text "날짜 설정"))))
(defwindow uw-countdown
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
