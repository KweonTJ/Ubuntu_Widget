; Personal integrations and additional native widgets.
(defwidget stocks-card []
 (extra-card :kind "stocks" :title "주식 · 토스증권" :tone "blue"
 (label :class "extra-detail" :text {services.stocks.status ?: "연결을 설정하세요."} :xalign 0 :wrap true :wrap-mode "wordchar")(label :class "extra-detail" :text {services.stocks.last_update ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")
 (box :orientation "v" :spacing 12 :space-evenly false
  (for row in {services.stocks.rows ?: "[]"}
   (box :orientation "v" :space-evenly false :spacing 3
    (box :orientation {sizes.stocks.width < 288 ? "v" : "h"} :space-evenly false :spacing 4
     (label :class "extra-note-title" :text {row.name} :xalign 0 :hexpand true :truncate true :limit-width 1)
     (label :class "extra-world-time" :text {row.value} :xalign 0))
    (label :class "extra-detail" :text {row.symbol + " · " + row.detail} :xalign 0 :wrap true :wrap-mode "wordchar"))))
(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-stocks" (label :text "연결·설정"))))
(defwindow uw-stocks
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-stocks" (stocks-card)))
(defwidget weather-card []
 (extra-card :kind "weather" :title "날씨" :tone "blue"
  (label :class "extra-note-title" :style {"font-size: " + sizes.weather.title + "px;"} :text {services.weather.city ?: "지역을 선택하세요"} :xalign 0 :truncate true :limit-width 1)
  (box :space-evenly false :spacing {sizes.weather.gap}
   (label :class "extra-value" :style {"font-size: " + sizes.weather.hero + "px;"} :text {services.weather.temperature ?: "—"} :xalign 0 :hexpand true)
   (box :orientation "v" :space-evenly false :valign "center" :visible {sizes.weather.height >= 150}
    (label :class "extra-detail" :text {services.weather.condition ?: ""} :xalign 1)
    (label :class "extra-detail" :text {services.weather.range ?: ""} :xalign 1)))
  (box :visible {sizes.weather.height >= 210} :space-evenly true :spacing 6
   (for hour in {services.weather.hours ?: "[]"}
    (box :visible {(hour.index ?: 0) < sizes.weather.hours} :class "forecast-hour" :orientation "v" :space-evenly false :spacing 5
     (label :class "extra-detail" :text {hour.name})
     (label :class "extra-note-title" :text {hour.value}))))
  (box :visible {sizes.weather.height >= 310} :orientation "v" :space-evenly false :spacing 7
   (for day in {services.weather.week ?: "[]"}
    (box :visible {(day.index ?: 0) < sizes.weather.rows} :space-evenly false :spacing 6
     (label :class "extra-detail" :text {day.name} :xalign 0 :hexpand true)
     (label :class "extra-detail" :text {day.detail} :xalign 0 :hexpand true)
     (label :class "extra-detail" :text {day.value} :xalign 1))))
  (label :visible {sizes.weather.height >= 360} :class "extra-detail" :text {services.weather.air ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")
  (button :visible {sizes.weather.height >= 180} :class "extra-button" :onclick "./scripts/manager-launch.py select uw-weather" (label :text "지역 설정"))))
(defwindow uw-weather
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-weather" (weather-card)))
(defwidget home-card []
 (extra-card :kind "home" :title "홈" :tone "yellow"
 (label :class "extra-detail" :text {services.home.status ?: "연결을 설정하세요."} :xalign 0 :wrap true :wrap-mode "wordchar")(label :class "extra-detail" :text {services.home.last_update ?: ""} :xalign 0 :wrap true :wrap-mode "wordchar")
 (box :orientation "v" :space-evenly false :spacing 10
  (for device in {services.home.rows ?: "[]"}
   (box :orientation "v" :space-evenly false :spacing 5
    (label :class "extra-note-title" :text {device.name} :xalign 0 :wrap true :wrap-mode "wordchar")
    (label :class "extra-detail" :text {device.value} :xalign 0 :wrap true :wrap-mode "wordchar")
    (button :class "extra-button" :visible {device.control}
     :onclick {"./scripts/integration_runtime.py home-action " + device.id + " " + device.action}
     (label :text {device.button})))))
(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-home" (label :text "연결·설정"))))
(defwindow uw-home
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-home" (home-card)))
(defwidget screentime-card []
 (extra-card :kind "screentime" :title "스크린 타임" :tone "purple"
  (label :class "extra-value" :style {"font-size: " + sizes.screentime.hero + "px;"} :text {services.screen.total ?: "0분"} :xalign 0 :truncate true :limit-width 1)
  (label :visible {sizes.screentime.height >= 150} :class "extra-detail" :text {services.screen.status ?: "기록 꺼짐"} :xalign 0 :wrap true :wrap-mode "wordchar")
  (box :visible {sizes.screentime.height >= 210} :orientation "v" :space-evenly false :spacing 8
   (for app in {services.screen.rows ?: "[]"}
    (box :class "app-row" :visible {(app.index ?: 0) < sizes.screentime.rows} :orientation "v" :space-evenly false :spacing 5
     (box :space-evenly false :spacing 8
      (label :class "extra-detail" :text {app.name} :xalign 0 :hexpand true :truncate true :limit-width 1)
      (label :class "extra-detail" :text {app.value} :xalign 1))
     (progress :value {app.percent ?: 0}))))
  (button :visible {sizes.screentime.height >= 180} :class "extra-button" :onclick "./scripts/manager-launch.py select uw-screentime" (label :text "기록 설정"))))
(defwindow uw-screentime
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-screentime" (screentime-card)))
(defwidget agenda-card []
 (extra-card :kind "agenda" :title "다가오는 일정" :tone "pink"

 (label :class "extra-detail" :visible {extra.agenda_empty ?: true} :text "다가오는 일정이 없습니다." :xalign 0 :wrap true :wrap-mode "wordchar")
 (box :orientation "v" :space-evenly false :spacing 12
  (for event in {extra.agenda ?: "[]"}
   (box :orientation "v" :space-evenly false :spacing 3
    (label :class "extra-detail" :text {event.date + " · " + event.time} :xalign 0)
    (label :class "extra-note-title" :text {event.title} :xalign 0 :wrap true :wrap-mode "wordchar"))))
(button :class "extra-button" :onclick "./scripts/manager-launch.py select uw-agenda" (label :text "일정 편집"))))
(defwindow uw-agenda
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-agenda" (agenda-card)))
(defwidget analog-card []
 (extra-card :kind "analog" :title "아날로그 시계" :tone "neutral"

 (image :visible {services.clock != ""} :path {services.clock ?: "assets/blank.svg"} :image-width {sizes.analog.face} :image-height {sizes.analog.face} :halign "center")
 (label :class "extra-detail" :visible {sizes.analog.height >= 145} :text {(services.clock_time ?: "—") + " · 이 PC의 현지 시각"} :xalign 0 :wrap true :wrap-mode "wordchar")
))
(defwindow uw-analog
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-analog" (analog-card)))
(defwidget podcast-card []
 (extra-card :kind "podcast" :title "팟캐스트" :tone "pink"

 (label :class "extra-note-title" :text {info.music.title ?: "재생 중인 미디어 없음"} :xalign 0 :wrap true :wrap-mode "wordchar")
 (label :class "extra-detail" :text {info.music.artist ?: "MPRIS 지원 앱에서 재생하세요"} :xalign 0 :wrap true :wrap-mode "wordchar")
 (box :orientation {sizes.podcast.width < 264 ? "v" : "h"} :space-evenly true :spacing 5
  (button :class "extra-button" :active {info.music.can_previous ?: false} :onclick "./scripts/data.py action previous" (label :text "이전"))
  (button :class "extra-button" :active {info.music.can_play ?: false} :onclick "./scripts/data.py action play" (label :text {info.music.playing ? "일시정지" : "재생"}))
  (button :class "extra-button" :active {info.music.can_next ?: false} :onclick "./scripts/data.py action next" (label :text "다음")))
))
(defwindow uw-podcast
 :monitor '["<primary>", 0]'
 :geometry (geometry :anchor "top right" :x "-32px" :y "51px" :width "320px" :height "224px")
 :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
 (movable-card :theme appearance :name "uw-podcast" (podcast-card)))
