  :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
  (movable-card :theme appearance :name "uw-sound" (sound-card)))


(defwidget web-card [id]
  (box :class {"card web-card glass-" + id} :orientation "v" :space-evenly false :vexpand true
    (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
      (button :class "web-open" :onclick "./scripts/widget-action.py launch ${id}" :timeout "3s"
        :tooltip {webitems[id + "-host"] ?: "웹사이트 열기"}
        (box :orientation "v" :space-evenly false :spacing 8 :valign "center" :hexpand true
          (label :class "web-letter" :text {webitems[id + "-letter"] ?: "W"} :halign "center")
          (label :class "web-title" :text {webitems[id + "-name"] ?: "웹사이트"} :truncate true :limit-width 22)
          (label :class "web-host" :text {webitems[id + "-host"] ?: ""} :truncate true :limit-width 25)
          (label :class "web-open-label" :text "웹앱 열기 ↗"))))))

