(deflisten appearance :initial "light" `./scripts/theme.py`)
(deflisten info :initial "{\"time\": \"--:--\", \"date\": \"\", \"zone\": \"Local time\", \"zone_detail\": \"System timezone\", \"calendar\": {\"month\": \"\", \"weeks\": []}, \"cpu\": 0, \"memory\": 0, \"memory_text\": \"\", \"disk\": 0, \"disk_text\": \"\", \"battery\": {\"value\": 0, \"label\": \"—\", \"detail\": \"\", \"available\": false}, \"sound\": {\"value\": 0, \"muted\": false, \"label\": \"—\", \"available\": false}, \"music\": {\"title\": \"No media playing\", \"artist\": \"\", \"status\": \"Media\", \"playing\": false, \"available\": false, \"can_play\": false, \"can_previous\": false, \"can_next\": false}, \"bluetooth\": {\"available\": false, \"powered\": false, \"count\": 0, \"devices\": [], \"empty\": \"No connected devices\"}}" `./scripts/data.py`)

(defwidget clock-card []
 (box :class {"card clock-card glass-uw-clock size-" + sizes.clock.mode}
  :style {"padding: " + sizes.clock.padding + "px;"} :orientation "v" :space-evenly false :vexpand true
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :vexpand true :valign "center" :spacing {sizes.clock.gap}
 (label :visible {sizes.clock.height >= 150} :class "eyebrow" :text "LOCAL TIME" :xalign 0)
 (label :truncate true :limit-width 1 :hexpand true :class "clock-time" :style {"font-size: " + sizes.clock.clock + "px;"} :text {info.time ?: "--:--"} :xalign 0)
 (label :visible {sizes.clock.height >= 128} :class "clock-date" :style {"font-size: " + sizes.clock.body + "px;"} :text {info.date ?: ""} :xalign 0)
 (label :visible {sizes.clock.height >= 270} :class "clock-zone" :text {info.zone_detail ?: "System timezone"} :xalign 0)))))

(defwidget calendar-card []
 (box :class {"card calendar-card glass-uw-calendar size-" + sizes.calendar.mode}
  :style {"padding: " + sizes.calendar.padding + "px;"} :orientation "v" :space-evenly false :vexpand true
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :vexpand true
 (label :class "calendar-title" :style {"font-size: " + sizes.calendar.title + "px;"} :text {info.calendar.month ?: "달력"} :xalign 0)
 (box :visible {sizes.calendar.height < 160} :space-evenly false :spacing 12 :vexpand true
  (label :class "extra-value" :style {"font-size: " + sizes.calendar.hero + "px;"} :text {extra.today ?: "—"} :xalign 0)
  (label :class "extra-detail" :text {extra.weekday ?: ""} :valign "center"))
 (box :visible {sizes.calendar.height >= 160} :orientation "v" :space-evenly false :vexpand true
  (box :class "weekdays" :space-evenly true
   (label :text "일") (label :text "월") (label :text "화") (label :text "수") (label :text "목") (label :text "금") (label :text "토"))
  (box :class "calendar-grid" :orientation "v" :space-evenly true :vexpand true
   (for week in {info.calendar.weeks ?: "[]"}
    (box :space-evenly true
     (for day in week
      (label :class {day.class} :text {day.label}
       :style {"font-size: " + sizes.calendar.day_font + "px; min-height: " + sizes.calendar.cell + "px;"}))))))))))

(defwidget meter [name value detail class]
 (box :class "meter ${class}" :orientation "v" :space-evenly false :hexpand true
  (label :class "meter-name" :style {"font-size: " + sizes.system.detail + "px;"} :text name :xalign 0)
  (label :class "meter-value" :style {"font-size: " + sizes.system.hero * 0.6 + "px;"} :text "${value}%" :xalign 0)
  (progress :value value)
  (label :visible {sizes.system.height >= 250} :class "meter-detail" :text detail :xalign 0 :truncate true :limit-width 15)))

(defwidget system-card []
 (box :class {"card system-card glass-uw-system size-" + sizes.system.mode}
  :style {"padding: " + sizes.system.padding + "px;"} :orientation "v" :space-evenly false :vexpand true
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :vexpand true
 (box :visible {sizes.system.height >= 145} :class "card-heading" :space-evenly false
  (image :path {appearance == "dark" ? "assets/computer-dark.svg" : "assets/computer.svg"} :image-width 16 :image-height 16)
  (label :text "시스템" :xalign 0 :hexpand true)
  (label :class "live" :text "LIVE"))
 (box :orientation {sizes.system.width < 264 && sizes.system.height > 280 ? "v" : "h"} :space-evenly true :vexpand true :valign "center" :spacing {sizes.system.gap}
  (meter :name "CPU" :value {info.cpu ?: 0} :detail "프로세서" :class "cpu")
  (meter :name "메모리" :value {info.memory ?: 0} :detail {info.memory_text ?: ""} :class "memory")
  (meter :name "저장공간" :value {info.disk ?: 0} :detail {info.disk_text ?: ""} :class "disk"))))))

(defwidget music-play [compact]
 (button :class {compact ? "play-button compact-play" : "play-button"} :active {info.music.can_play ?: false}
  :tooltip "재생 / 일시 정지" :onclick "./scripts/data.py action play"
  (image :path {"assets/" + (info.music.playing ? "pause" : "play") + (appearance == "dark" ? "-dark.svg" : ".svg")} :image-width 16 :image-height 16)))
(defwidget music-card []
 (box :class {"card music-card glass-uw-music size-" + sizes.music.mode}
  :style {"padding: " + sizes.music.padding + "px;"} :orientation "v" :space-evenly false :vexpand true
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :spacing {sizes.music.music_gap} :hexpand true :vexpand true :valign "center"
    (overlay :halign "center"
     (image :class "music-art" :halign "center" :valign "center" :tooltip "앨범 커버"
      :path {(info.music.art ?: "") != "" ? info.music.art : appearance == "dark" ? "assets/music-dark.svg" : "assets/music.svg"}
      :image-width {sizes.music.music_art} :image-height {sizes.music.music_art})
     (button :visible {sizes.music.height < 240} :class "play-button music-cover-play" :halign "end" :valign "end"
      :active {info.music.can_play ?: false} :tooltip "재생 / 일시 정지" :onclick "./scripts/data.py action play"
      (image :path {"assets/" + (info.music.playing ? "pause" : "play") + "-dark.svg"}
       :image-width {sizes.music.music_art < 48 ? 12 : 16} :image-height {sizes.music.music_art < 48 ? 12 : 16})))
    (box :orientation "v" :space-evenly false :hexpand true :spacing 3
     (label :class "music-title" :style {"font-size: " + sizes.music.title + "px;"}
      :text {info.music.title ?: "재생 중인 음악 없음"} :tooltip {info.music.title ?: ""}
      :xalign 0.5 :limit-width 1 :truncate true :hexpand true)
     (label :visible {sizes.music.height >= 200} :class "music-artist" :style {"font-size: " + sizes.music.music_detail + "px;"}
      :text {info.music.artist ?: ""} :tooltip {info.music.artist ?: ""} :xalign 0.5 :limit-width 1 :truncate true :hexpand true))
    (box :visible {sizes.music.height >= 240} :class "music-controls" :space-evenly false :halign "center" :spacing {sizes.music.gap}
     (button :class "transport-button" :active {info.music.can_previous ?: false} :tooltip "이전 곡" :onclick "./scripts/data.py action previous"
      (image :path {appearance == "dark" ? "assets/previous-dark.svg" : "assets/previous.svg"} :image-width 16 :image-height 16))
     (music-play :compact false)
     (button :class "transport-button" :active {info.music.can_next ?: false} :tooltip "다음 곡" :onclick "./scripts/data.py action next"
      (image :path {appearance == "dark" ? "assets/next-dark.svg" : "assets/next.svg"} :image-width 16 :image-height 16)))))))

(defwidget battery-device [name value known text icon detail low]
 (box :class "battery-device" :orientation "v" :space-evenly false :spacing 4 :halign "center" :valign "center"
  :tooltip {name + " · " + text + (detail == "" ? "" : " · " + detail)}
  (circular-progress :class {"battery-ring " + (!known ? "unknown" : low ? "low" : "")} :value {known ? value : 0} :start-at 75 :clockwise true
   :thickness {sizes.battery.battery_ring * 0.075} :width {sizes.battery.battery_ring} :height {sizes.battery.battery_ring}
   (image :path {"assets/battery-" + icon + (appearance == "dark" ? "-dark.svg" : ".svg")} :image-width {floor(sizes.battery.battery_ring * 0.55)} :image-height {floor(sizes.battery.battery_ring * 0.55)}))
  (box :orientation "v" :space-evenly false :spacing 3 :valign "center"
   (label :class {"battery-ring-value " + (low ? "low" : "")} :style {"font-size: " + (sizes.battery.height < 160 ? 11 : floor(sizes.battery.battery_ring * 0.32)) + "px;"} :text {known ? text : "—"} :xalign 0.5)
   (label :visible {sizes.battery.height >= 260} :class "battery-device-name" :style {"font-size: " + sizes.battery.detail + "px;"} :text name :truncate true :limit-width 16 :xalign 0.5)
   (label :visible {sizes.battery.height >= 420} :class "battery-device-detail" :text {known ? detail : "잔량 정보 없음"} :truncate true :limit-width 19))))

(defwidget battery-card []
 (box :class {"card battery-card glass-uw-battery size-" + sizes.battery.mode} :style {"padding: " + sizes.battery.padding + "px;"} :orientation "v" :space-evenly false :vexpand true :spacing 5
  (label :visible {sizes.battery.height >= 180} :class "small-heading" :text "배터리" :xalign 0)
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :vexpand true :spacing {sizes.battery.gap}
    (box :visible {sizes.battery.height < 160} :space-evenly true :spacing 10 :vexpand true
     (for device in {info.battery_devices ?: "[]"}
      (box :space-evenly false :valign "center"
       (battery-device :name {device.name} :value {device.value} :known {device.known} :text {device.label} :icon {device.icon} :detail {device.detail} :low {device.low}))))
    (box :visible {sizes.battery.height >= 160} :orientation "v" :space-evenly true :vexpand true :spacing {sizes.battery.gap}
     (for row in {sizes.battery.width >= 500 ? (info.battery_rows3 ?: "[]") : (info.battery_rows2 ?: "[]")}
      (box :space-evenly true :spacing 8
       (for device in row
        (battery-device :name {device.name} :value {device.value} :known {device.known} :text {device.label} :icon {device.icon} :detail {device.detail} :low {device.low})))))))))

(defwidget sound-card []
 (box :class {"card sound-card glass-uw-sound size-" + sizes.sound.mode}
  :style {"padding: " + sizes.sound.padding + "px;"} :orientation "v" :space-evenly false :vexpand true
  (scroll :class "content-scroll" :hscroll true :vscroll true :hexpand true :vexpand true
   (box :orientation "v" :space-evenly false :vexpand true
 (label :visible {sizes.sound.height >= 160} :class "small-heading" :text "사운드" :xalign 0)
 (label :class "sound-value" :style {"font-size: " + sizes.sound.hero + "px;"} :text {info.sound.label ?: "--"} :xalign 0 :vexpand true)
 (box :class "sound-controls" :space-evenly true :spacing 8
  (button :active {info.sound.available ?: false} :tooltip "볼륨 5% 줄이기" :onclick "./scripts/data.py action quieter" (label :text "−"))
  (button :active {info.sound.available ?: false} :tooltip "음소거 전환" :onclick "./scripts/data.py action mute"
   (image :path {"assets/" + (info.sound.muted ? "muted" : "sound") + (appearance == "dark" ? "-dark.svg" : ".svg")} :image-width 16 :image-height 16))
  (button :active {info.sound.available ?: false} :tooltip "볼륨 5% 높이기" :onclick "./scripts/data.py action louder" (label :text "+")))))))

(defwidget movable-card [name theme]
  (box :class {(theme == "dark" ? "movable-canvas eww-dark" : "movable-canvas eww-light") + " widget-" + name + (glass.enabled ? " glass-master-on" : "") + (services.tracking ? " usage-recording" : "")} :orientation "v" :space-evenly false
    (overlay :hexpand true :vexpand true
      (eventbox :drag-window true :drag-grid 16
        :onwindowdrop "./scripts/stacks.py drop ${name} {0} {1} {2} {3} {4} {5}"
        :window-swipe {(stacks[name + "-count"] ?: 0) > 1}
        :onwindowswipe "./scripts/stacks.py swipe ${name} {}"
        :onrightclick "./scripts/manager-launch.py menu ${name}" :timeout "2s"
        (box :orientation "v" :space-evenly false :vexpand true (children)))
      (eventbox :visible {(stacks[name + "-count"] ?: 0) > 1} :halign "center" :valign "end" :onscroll "./scripts/stacks.py {} ${name}" :timeout "3s"
       (button :class "stack-indicator" :timeout "3s" :tooltip "클릭·휠 또는 본문에서 두 손가락 가로 스와이프로 전환" :onclick "./scripts/stacks.py next ${name}"
        (label :text {stacks[name + "-label"] ?: ""})))
      (button :class "close-widget" :halign "start" :valign "start" :style "margin: 6px;"
        :tooltip "위젯 지우기 · 앱 메뉴에서 복원 가능" :onclick "./scripts/windows.py remove ${name}"
        (label :text "×"))
      (eventbox :resize-window true :resize-axis "horizontal" :resize-edge "left" :resize-grid 16
        :resize-min-width 192 :resize-min-height 96 :cursor "ew-resize"
        :halign "start" :valign "fill" :tooltip "드래그해서 왼쪽 가로폭 조절"
        (box :class "width-grip" :vexpand true))
      (eventbox :resize-window true :resize-axis "horizontal" :resize-grid 16
        :resize-min-width 192 :resize-min-height 96 :cursor "ew-resize"
        :halign "end" :valign "fill" :tooltip "좌우로 드래그해서 가로폭 조절"
        (box :class "width-grip" :vexpand true))
    )
    (eventbox :resize-window true :resize-axis "vertical" :resize-grid 16 :resize-min-width 192 :resize-min-height 96
      :cursor "ns-resize" :halign "fill" :hexpand true :tooltip "위아래로 드래그해서 높이 조절"
      (box :class "height-grip" :hexpand true))))

(defwindow uw-clock
  :monitor '["<primary>", 0]'
  :geometry (geometry :anchor "top right" :x "-368px" :y "51px" :width "320px" :height "224px")
  :stacking "bg" :windowtype "desktop" :wm-ignore false :resizable true
  (movable-card :theme appearance :name "uw-clock" (clock-card)))

